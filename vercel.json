{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "{backend/**,frontend/**,database/**,n8n-workflows/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
