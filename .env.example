# ============================================================
# GYM MANAGER AUTOMATION SYSTEM — ENVIRONMENT CONFIGURATION
# ============================================================

# Server & Timezone
PORT=3000
TZ=Asia/Kolkata

# n8n Webhook URLs (When connecting Frontend to a live n8n instance)
# Leave blank to use the built-in local n8n Workflow Engine & Google Sheets Simulator
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_REGISTER_WEBHOOK_PATH=/gym-register-member
N8N_PAYMENT_WEBHOOK_PATH=/gym-payment-webhook
N8N_MANUAL_PAYMENT_PATH=/gym-manual-payment

# Google Sheets Configuration
GOOGLE_SHEETS_SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz_GYM_DATABASE_ID

# MongoDB Atlas Cloud Database (Optional Two-Way Sync with Google Sheets)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=gym_manager_saas

# WhatsApp Business Cloud API (Meta Graph API v20.0)
WHATSAPP_PHONE_NUMBER_ID=109283746510293
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321012345
WHATSAPP_ACCESS_TOKEN=EAAGm0PX4ZCpsBA...YOUR_SYSTEM_USER_PERMANENT_TOKEN

# Razorpay Payment Gateway & Webhook Secret
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=gym_rzp_whsec_9f8e7d6c5b4a3f2e1d0c

# Gmail / SMTP Notification Settings
GMAIL_OWNER_EMAIL=owner@ironfitgym.in
